{
  "name": "pvtkrrx",
  "version": "1.1.69",
  "description": "PVTKRRX — Stream from your private tracker seedbox through Stremio",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "assets:site": "node scripts/generate-social-assets.js",
    "server:setup": "node scripts/server-installer.js",
    "server:legacy-setup": "node scripts/server-setup.js",
    "server:install-service": "node scripts/install-systemd-service.js",
    "smoke:parity": "node scripts/smoke-parity-helpers.js",
    "smoke:sports-resolution": "node scripts/smoke-sports-resolution.js",
    "smoke:sports": "node scripts/smoke-sports-resolution.js && node scripts/smoke-sport-backdrops.js",
    "smoke:sport-backdrops": "node scripts/smoke-sport-backdrops.js",
    "smoke:sports-broadcast": "node scripts/smoke-sports-broadcast-artwork.js",
    "smoke:sports-competitor-vs-competitor": "node scripts/smoke-sports-competitor-vs-competitor.js",
    "smoke:sports-team-vs-team": "node scripts/smoke-sports-team-vs-team.js",
    "smoke:sports-single-event-motorsport": "node scripts/smoke-sports-single-event-motorsport.js",
    "smoke:sports-artwork": "node scripts/smoke-sports-artwork-layout.js",
    "smoke:sports-poster-classifier": "node scripts/smoke-sports-poster-classifier.js",
    "smoke:sports-poster-adapter": "node scripts/smoke-sports-poster-adapter.js",
    "smoke:sports-poster-render": "node scripts/smoke-sports-poster-render.js",
    "smoke:sportcult-category-map": "node scripts/smoke-sportcult-category-map.js",
    "smoke:sportcult-rss-replay": "node scripts/smoke-sportcult-rss-replay.js",
    "smoke:sports-template-families": "node scripts/smoke-sports-template-families.js",
    "smoke:free-tier-artwork": "node scripts/smoke-free-tier-artwork.js",
    "smoke:entitlement": "node scripts/smoke-entitlement.js",
    "smoke:sports-catalog-seeds": "node scripts/smoke-sports-catalog-seeds.js",
    "smoke:sports-latency": "node scripts/smoke-sports-catalog-latency.js",
    "smoke:sports-catalog-latency": "node scripts/smoke-sports-catalog-latency.js",
    "audit:sports-artwork": "node scripts/audit-sports-artwork.js",
    "audit:sports-posters": "node scripts/audit-sports-posters.js",
    "prewarm:sports-posters": "node scripts/prewarm-sports-posters.js",
    "debug:sports-artwork": "node scripts/debug-sports-artwork-viewer.js --serve --open",
    "smoke:config": "node scripts/smoke-config-flow.js",
    "smoke:guards": "node scripts/smoke-runtime-guards.js",
    "smoke:remote-seedbox-guard": "node scripts/smoke-remote-seedbox-guard.js",
    "smoke:selfhost": "node scripts/smoke-selfhost-server.js",
    "smoke:lan-pair": "node scripts/smoke-lan-pair-flow.js",
    "smoke:pipeline": "node scripts/smoke-stream-pipeline.js",
    "smoke:stremio-link": "node scripts/smoke-stremio-link.js",
    "smoke:security": "node scripts/smoke-security.js",
    "smoke:playback": "node scripts/smoke-playback-route.js",
    "smoke:desktop": "node scripts/smoke-desktop-provision.js",
    "smoke:win-installer-path": "node scripts/smoke-win-installer-path.js",
    "smoke:provider-discovery": "node scripts/smoke-provider-discovery.js",
    "probe:sports-item": "node scripts/probe-sports-item.js",
    "desktop:dev": "electron electron/main.js",
    "dist:win": "node scripts/build-win.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kepners/pvtkrrx.git"
  },
  "keywords": [
    "stremio",
    "addon",
    "private-tracker",
    "seedbox",
    "torznab"
  ],
  "author": "Kepners",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Kepners/pvtkrrx/issues"
  },
  "homepage": "https://github.com/Kepners/pvtkrrx#readme",
  "dependencies": {
    "@umami/node": "^0.4.0",
    "7zip-bin": "^5.2.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.0",
    "multicast-dns": "^7.2.5",
    "pg": "^8.20.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.5",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kepners.pvtkrrx",
    "productName": "PVTKRRX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "electron/assets/logo.ico",
      "requestedExecutionLevel": "highestAvailable",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "installerIcon": "electron/assets/logo.ico",
      "uninstallerIcon": "electron/assets/logo.ico",
      "installerHeaderIcon": "electron/assets/logo.ico"
    }
  }
}
