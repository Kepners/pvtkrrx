{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/logo.ico",
      "dest": "https://raw.githubusercontent.com/Kepners/pvtkrrx/main/public/logo.ico"
    },
    {
      "src": "/logo.svg",
      "dest": "https://raw.githubusercontent.com/Kepners/pvtkrrx/main/public/logo.svg"
    },
    {
      "src": "/favicon.ico",
      "dest": "https://raw.githubusercontent.com/Kepners/pvtkrrx/main/public/logo.ico"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/configure",
      "dest": "/public/configure.html"
    },
    {
      "src": "/runbooks",
      "dest": "/public/runbooks.html"
    },
    {
      "src": "/seedbox-runbooks",
      "dest": "/public/runbooks.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
